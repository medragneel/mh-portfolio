---
import { nav, site } from "../data/site";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand mono">
      <span class="brand-caret">&gt;_</span>MedMh
    </a>

    <nav class="links" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
        <div class="btns">

<a
    class="btn btn-shop"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Open ecommerce-mode — 360prod-dev, in a new tab"
    >
      <span class="dot dot-shop" aria-hidden="true"></span>
      Dev-mode
    </a>

    <a
      class="btn btn-mode"
      href={site.designModeUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Open design-mode — 26.MH Studio, in a new tab"
    >
      <span class="dot" aria-hidden="true"></span>
      design-mode
    </a>
</div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(10px);
    background: rgba(12, 13, 15, 0.72);
    border-bottom: 1px solid var(--border-soft);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 20px;
    padding-block: 16px;
  }
  .btns{
      display:flex;
      gap:1em;
  }

  .brand {
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .brand-caret {
    color: var(--accent);
    margin-right: 6px;
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }

  .links a {
    text-decoration: none;
    color: var(--text-dim);
    transition: color 0.18s ease;
  }

  .links a:hover {
    color: var(--text);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 0 3px rgba(var(--accent-2-rgb), 0.18);
  }
  .btn-shop {
    border-color: rgba(var(--accent-rgb), 0.45);
    color: var(--accent);
  }

  .btn-shop:hover {
    background: rgba(var(--accent-rgb), 0.1);
    border-color: var(--accent);
  }

  .dot-shop {
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.18);
  }

  .nav-inner {
    gap: 12px;
  }

  @media (max-width: 720px) {
    .links {
      display: none;
    }
  }
</style>
