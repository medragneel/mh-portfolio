---
import { timeline } from "../data/site";
---

<section id="stack">
  <div class="wrap">
    <p class="eyebrow">log --oneline --graph</p>
    <div class="section-head">
      <h2 class="section-title">How the stack was built</h2>
      <p class="section-note">Not a résumé list — the actual order things were learned in.</p>
    </div>

    <ol class="log">
      {timeline.map((entry, i) => (
        <li class="row">
          <span class="year mono">{entry.year}</span>
          <span class="node" aria-hidden="true"></span>
          <span class="content">
            <span class="label">{entry.label}</span>
            <span class="note mono">{entry.note}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 60px 20px 1fr;
    align-items: baseline;
    position: relative;
  }

  .row::before {
    content: "";
    position: absolute;
    left: 69px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .row:first-child::before {
    top: 12px;
  }

  .row:last-child::before {
    bottom: calc(100% - 12px);
  }

  .year {
    font-size: 12.5px;
    color: var(--text-faint);
    padding: 16px 0;
  }

  .node {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent-2);
    justify-self: center;
    z-index: 1;
  }

  .content {
    padding: 15px 0 15px 18px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border-soft);
  }

  .row:last-child .content {
    border-bottom: none;
  }

  .label {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
  }

  .note {
    font-size: 12.5px;
    color: var(--text-faint);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 44px 16px 1fr;
    }
    .row::before {
      left: 51px;
    }
  }
</style>
