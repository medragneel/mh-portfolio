---
import { site, socials } from "../data/site";
---

<section id="contact">
  <div class="wrap contact-inner">
    <p class="eyebrow">contact.sh</p>
    <h2 class="section-title big">
      Got a project<br /><span class="accent">in mind?</span>
    </h2>
    <p class="sub">
      If you're passing by and want to ask something, or just say hi —
      my inbox is always open.
    </p>
    <div class="actions">
      <a class="btn btn-solid" href={`mailto:${site.email}`}>Say hi ↗</a>
      <a class="btn btn-mode" href={site.designModeUrl} target="_blank" rel="noopener noreferrer">
        design-mode
      </a>
    </div>
    <div class="socials mono">
      {socials.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact-inner {
    text-align: center;
    max-width: 620px;
  }

  .big {
    font-size: clamp(34px, 6vw, 54px);
    line-height: 1.08;
    margin-bottom: 20px;
  }

  .accent {
    color: var(--accent);
  }

  .sub {
    color: var(--text-dim);
    font-size: 16px;
    max-width: 44ch;
    margin: 0 auto 34px;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 18px;
    font-size: 12.5px;
  }

  .socials a {
    text-decoration: none;
    color: var(--text-faint);
    transition: color 0.18s ease;
  }

  .socials a:hover {
    color: var(--accent-2);
  }

  @media (max-width: 560px) {
    .actions {
      flex-direction: column;
    }
  }
</style>
