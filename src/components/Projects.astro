---
import { projects } from "../data/site";
---

<section id="work">
  <div class="wrap">
    <p class="eyebrow">~/projects</p>
    <div class="section-head">
      <h2 class="section-title">Selected work</h2>
      <p class="section-note">{projects.length} repositories, shipped and live.</p>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <article class="card">
          <div class="thumb">
            <img src={p.image} alt={`${p.title} preview`} loading="lazy" />
          </div>
          <div class="body">
            <div class="row">
              <span class="dot" style={`background:${p.lang}`} aria-hidden="true"></span>
              <span class="name mono">{p.name}</span>
            </div>
            <h3 class="title">{p.title}</h3>
            <p class="desc">{p.description}</p>
            <div class="foot">
              <div class="tags mono">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              <div class="links">
                {p.site && (
                  <a href={p.site} target="_blank" rel="noopener noreferrer" aria-label={`Open ${p.title} live site`}>site ↗</a>
                )}
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener noreferrer" aria-label={`Open ${p.title} source`}>repo ↗</a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--text-faint);
    transform: translateY(-2px);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    background: var(--bg-elevated-2);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }

  .name {
    font-size: 12px;
    color: var(--text-faint);
  }

  .title {
    font-size: 19px;
    margin: 0 0 8px;
  }

  .desc {
    font-size: 14px;
    color: var(--text-dim);
    margin: 0 0 20px;
    flex: 1;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tags {
    display: flex;
    gap: 6px;
    font-size: 11px;
  }

  .tag {
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 3px 7px;
    color: var(--text-faint);
  }

  .links {
    display: flex;
    gap: 14px;
    font-size: 12.5px;
  }

  .links a {
    text-decoration: none;
    color: var(--accent-2);
  }

  .links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
